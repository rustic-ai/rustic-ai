      "maxItems": 32,
      "title": "Sources",
      "type": "array"
    },
    "query": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query"
    },
    "allow_partial": {
      "default": false,
      "title": "Allow Partial",
      "type": "boolean"
    },
    "require_evidence": {
      "default": true,
      "title": "Require Evidence",
      "type": "boolean"
    }
  },
  "required": [
    "request_id"
  ],
  "title": "DocumentWorkflowRequest",
  "type": "object"
