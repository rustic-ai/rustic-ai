  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/MemorySource"
