{
  "$defs": {
    "EmbeddingConfigModel": {
      "additionalProperties": false,
      "description": "The embedding model (``embedding``).",
      "properties": {
        "model_id": {
          "default": "BGESmallENV15",
          "title": "Model Id",
          "type": "string"
        },
        "dimensions": {
          "default": 384,
          "title": "Dimensions",
          "type": "integer"
        },
        "batch_size": {
          "default": 32,
          "title": "Batch Size",
          "type": "integer"
        },
        "document_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Prefix"
        },
        "query_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Represent this sentence for searching relevant passages: ",
          "title": "Query Prefix"
        },
        "execution_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Providers"
        },
        "provider": {
          "default": "local/onnx",
          "title": "Provider",
          "type": "string"
        },
        "provider_options": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Options"
        },
        "sparse_dimensions": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse Dimensions"
        },
        "multivector_dimensions": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multivector Dimensions"
        }
      },
      "title": "EmbeddingConfigModel",
      "type": "object"
    },
    "NlpConfigModel": {
      "additionalProperties": false,
      "description": "The NLP model behind NER and observation extraction (``nlp``).\n\n``generation`` must match ``model_id``: ``\"v1\"`` for the default\ncascade, ``\"v7\"`` for a ``kniv-v7-*-en`` model. ``artifact`` applies to\nv1 only and ``variant`` (a precision fallback chain such as\n``\"int8,fp16\"``) to v7 only. ``UnikoBuilder.nlp(\"v7-small\")`` and the\nother presets fill these in.",
      "properties": {
        "model_id": {
          "default": "dragonscale-ai/kniv-deberta-nlp-base-en-xsmall",
          "title": "Model Id",
          "type": "string"
        },
        "generation": {
          "default": "v1",
          "enum": [
            "v1",
            "v7"
          ],
          "title": "Generation",
          "type": "string"
        },
        "artifact": {
          "default": "onnx/cascade-int8.onnx",
          "title": "Artifact",
          "type": "string"
        },
        "variant": {
          "default": "int8",
          "title": "Variant",
          "type": "string"
        },
        "max_batch_size": {
          "default": 16,
          "title": "Max Batch Size",
          "type": "integer"
        },
        "execution_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Providers"
        }
      },
      "title": "NlpConfigModel",
      "type": "object"
    },
    "OcrConfigModel": {
      "additionalProperties": false,
      "description": "OCR for tiered PDF extraction (``ocr``), off by default.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "model_id": {
          "default": "monkt/paddleocr-onnx",
          "title": "Model Id",
          "type": "string"
        },
        "rec_artifact": {
          "default": "languages/english/rec.onnx",
          "title": "Rec Artifact",
          "type": "string"
        },
        "char_dict_path": {
          "default": "languages/english/dict.txt",
          "title": "Char Dict Path",
          "type": "string"
        },
        "det_artifact": {
          "default": "detection/v5/det.onnx",
          "title": "Det Artifact",
          "type": "string"
        },
        "image_height": {
          "default": 48,
          "title": "Image Height",
          "type": "integer"
        },
        "image_width": {
          "default": 320,
          "title": "Image Width",
          "type": "integer"
        },
        "max_image_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Image Width"
        },
        "normalization": {
          "default": "siglip",
          "title": "Normalization",
          "type": "string"
        },
        "execution_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Providers"
        }
      },
      "title": "OcrConfigModel",
      "type": "object"
    },
    "RerankerConfigModel": {
      "additionalProperties": false,
      "description": "The cross-encoder reranker (``reranker``).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "model_id": {
          "default": "cross-encoder/ms-marco-MiniLM-L-6-v2",
          "title": "Model Id",
          "type": "string"
        },
        "top_n": {
          "default": 50,
          "title": "Top N",
          "type": "integer"
        },
        "apply_sigmoid": {
          "default": true,
          "title": "Apply Sigmoid",
          "type": "boolean"
        },
        "execution_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Providers"
        },
        "style": {
          "default": "cross-encoder",
          "title": "Style",
          "type": "string"
        }
      },
      "title": "RerankerConfigModel",
      "type": "object"
    }
  },
