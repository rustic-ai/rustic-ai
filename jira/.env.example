# JIRA Connection Configuration

# JIRA instance URL
JIRA_INSTANCE_URL=http://localhost:8080

# Authentication Option 1: Personal Access Token (Recommended)
JIRA_TOKEN=your-personal-access-token-here

# Authentication Option 2: Username and Password/API Token
# JIRA_USERNAME=admin
# JIRA_PASSWORD=your-password-or-api-token

# For JIRA Cloud, use your email as username and an API token as password
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
