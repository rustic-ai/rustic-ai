{
    "name": "Uniko Research Guild",
    "description": "Advanced research guild with persistent memory using Uniko cognitive memory system, combining KB search, web scraping, and intelligent memory management.",
    "version": "v2",
    "icon": null,
    "intro_msg": "Welcome to the Uniko Research Guild! I can help you research topics with persistent memory. What would you like to explore?",
    "exposure": "public",
    "author_id": "dummyuserid",
    "organization_id": "acmeorganizationid",
    "category_id": null,
    "tags": [
        "research",
        "memory",
        "uniko",
        "knowledge-base"
    ],
    "commands": [],
    "starter_prompts": [
        "Research recent developments in quantum computing",
        "Find information about sustainable energy solutions",
        "What have I previously researched about AI?"
    ],
    "spec": {
        "name": "Uniko Research Guild",
        "description": "Advanced research guild with persistent memory using Uniko cognitive memory system, combining KB search, web scraping, and intelligent memory management.",
        "agents": [
            {
                "id": "memory_agent",
                "name": "Memory Agent",
                "description": "Comprehensive memory agent using Uniko's 5-tier cognitive memory system for persistent knowledge storage and recall",
                "class_name": "rustic_ai.uniko_agent.agent.MemoryAgent",
                "additional_topics": [
                    "memory_observe",
                    "memory_recall",
                    "memory_answer",
                    "memory_ingest"
                ],
                "listen_to_default_topic": false,
                "properties": {
                    "default_session_id": null,
                    "recall_max_tokens": 3000,
                    "recall_phase1_only": false,
                    "auto_flush": false,
                    "allowed_record_producers": {
                        "user_assertion": [
                            "research_coordinator"
                        ],
                        "assistant_response": [
                            "research_coordinator"
                        ],
                        "model_interpretation": [
                            "research_coordinator"
                        ],
                        "external_evidence": [
                            "research_coordinator"
                        ]
                    },
                    "scope_producers": [
                        "research_coordinator"
                    ]
                }
            },
            {
                "id": "google_agent",
                "name": "Google Research Agent",
                "description": "Performs intelligent Google Search with grounding",
                "class_name": "rustic_ai.vertexai.agents.google_research_agent.GoogleResearchAgent",
                "additional_topics": [
                    "google_agent"
                ],
                "listen_to_default_topic": false,
                "properties": {
                    "project_id": null,
                    "location": null,
                    "model_id": "gemini-2.5-pro"
                }
            },
            {
                "id": "serp_agent",
                "name": "Search Agent",
                "description": "Handles search engine results page queries via SerpAPI",
                "class_name": "rustic_ai.serpapi.agent.SERPAgent",
                "additional_topics": [
                    "serp_agent"
                ],
                "properties": {},
                "listen_to_default_topic": false
            },
            {
                "id": "playwright_agent",
                "name": "Web Scraper Agent",
                "description": "Web scraping agent using Playwright for content extraction",
                "class_name": "rustic_ai.playwright.agent.PlaywrightScraperAgent",
                "additional_topics": [
                    "playwright_agent"
                ],
                "properties": {
                    "headless": true,
                    "parallel_pages": 5
                },
                "listen_to_default_topic": false
            },
            {
                "id": "synthesis_agent",
                "name": "Synthesis Agent",
                "description": "Synthesizes research findings and generates comprehensive answers",
                "class_name": "rustic_ai.llm_agent.llm_agent.LLMAgent",
                "additional_topics": [
                    "synthesis_agent"
                ],
                "listen_to_default_topic": false,
                "properties": {
                    "model": "gpt-4.1",
                    "default_system_prompt": "You are a research synthesis expert. Analyze the provided context from multiple sources and generate a comprehensive, well-structured answer to the user's question. Include key insights, relevant facts, and cite sources when applicable. Be thorough but concise.",
                    "max_tokens": 800
                }
            },
            {
                "id": "query_agent",
                "name": "Query Agent",
                "description": "Generates optimized search queries using LLM for comprehensive research coverage",
                "class_name": "rustic_ai.llm_agent.llm_agent.LLMAgent",
                "additional_topics": [
                    "query_agent"
                ],
                "listen_to_default_topic": false,
                "properties": {
                    "model": "gpt-4.1",
                    "default_system_prompt": "Generate 2 comprehensive google-optimized subqueries for deep research on the topic.\n\nFor thorough coverage, create subqueries across multiple dimensions:\n- Core concepts and definitions\n- Latest developments and breakthroughs (recent news, 2025-2026)\n- Historical context and evolution\n- Technical implementations and real-world applications\n- Expert opinions, academic research, and papers\n- Industry trends, market analysis, and adoption\n- Future implications, predictions, and emerging patterns\n- Challenges, limitations, and critiques\n- Related technologies, comparisons, and alternatives\n- Case studies and practical examples\n\nConsider when creating subqueries:\n- Neural search formulation: Use natural language questions and descriptive phrases\n- Domain filters: Suggest specific domains when relevant (arxiv.org for papers, techcrunch.com for tech news)\n- Time periods: Specify recent, past_week, past_month, past_year, or any\n- Content types: Specify type when relevant (news, research paper, pdf, blog, tutorial)\n\nEach subquery should focus on a different aspect to ensure comprehensive, multi-dimensional coverage.\n\nOutput format:\n- Separate queries using '####' as delimiter\n- Example: Query 1####Query 2####Query 3\n- Return ONLY the queries, nothing else"
                }
            },
            {
                "id": "gateway_agent",
                "name": "Research Gateway",
                "description": "Gateway agent for receiving research requests from other guilds",
                "class_name": "rustic_ai.core.guild.g2g.gateway_agent.GatewayAgent",
                "additional_topics": [
                    "outbound"
                ],
                "listen_to_default_topic": false,
                "properties": {
                    "input_formats": [
                        "rustic_ai.showcase.uniko_research.ResearchRequest"
                    ],
                    "output_formats": [
                        "rustic_ai.showcase.uniko_research.ResearchResults"
                    ],
                    "returned_formats": []
                }
            },
            {
                "id": "research_coordinator",
                "name": "Research Coordinator",
                "description": "Comprehensive memory agent using Uniko's 5-tier cognitive memory system for persistent knowledge storage and recall",
                "class_name": "rustic_ai.showcase.uniko_research.UnikoResearchCoordinator",
                "additional_topics": [
                    "research_coordinator"
                ],
                "listen_to_default_topic": false,
                "properties": {}
            }
        ],
        "dependency_map": {},
        "routes": {
            "steps": [
                {
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionRequest",
                    "destination": {
                        "topics": "research_coordinator"
                    },
                    "agent_type": "rustic_ai.core.agents.utils.user_proxy_agent.UserProxyAgent"
                },
                {
                    "agent": {
                        "id": "gateway_agent"
                    },
                    "message_format": "rustic_ai.showcase.uniko_research.ResearchRequest",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.RecallRequest",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.RecordMemoryRequest",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.FinalizeMemorySessionRequest",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.IngestDocumentRequest",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionRequest",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.serpapi.agent.SERPQuery",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.playwright.agent.WebScrapingRequest",
                    "transformer": {
                        "style": "content_based_router",
                        "handler": "{\"format\": $.format, \"payload\": $.payload, \"topics\": $.context.next_topic}"
                    }
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionResponse",
                    "destination": {
                        "topics": "user_message_broadcast"
                    },
                    "process_status": "completed"
                },
                {
                    "agent": {
                        "id": "research_coordinator"
                    },
                    "message_format": "rustic_ai.showcase.uniko_research.ResearchResults",
                    "destination": {
                        "topics": "gateway_agent"
                    },
                    "process_status": "completed"
                },
                {
                    "agent": {
                        "id": "memory_agent"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.RecallResponse",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "memory_agent"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.RecordMemoryResult",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "memory_agent"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.IngestOutcome",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "memory_agent"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.FinalizeMemorySessionResult",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "memory_agent"
                    },
                    "message_format": "rustic_ai.uniko_agent.models.MemoryAgentError",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "query_agent"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionResponse",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "query_agent"
                    },
                    "message_format": "rustic_ai.core.agents.commons.message_formats.ErrorMessage",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "synthesis_agent"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionResponse",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "synthesis_agent"
                    },
                    "message_format": "rustic_ai.core.agents.commons.message_formats.ErrorMessage",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "google_agent"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionResponse",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "google_agent"
                    },
                    "message_format": "rustic_ai.core.agents.commons.message_formats.ErrorMessage",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "serp_agent"
                    },
                    "message_format": "rustic_ai.serpapi.agent.SERPResults",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "serp_agent"
                    },
                    "message_format": "rustic_ai.serpapi.agent.SearchError",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "playwright_agent"
                    },
                    "message_format": "rustic_ai.playwright.agent.WebScrapingCompleted",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "playwright_agent"
                    },
                    "message_format": "rustic_ai.core.agents.commons.message_formats.ErrorMessage",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "synthesis_agent"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionError",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "query_agent"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionError",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                },
                {
                    "agent": {
                        "id": "google_agent"
                    },
                    "message_format": "rustic_ai.core.guild.agent_ext.depends.llm.models.ChatCompletionError",
                    "destination": {
                        "topics": "research_coordinator"
                    }
                }
            ]
        }
    }
}
