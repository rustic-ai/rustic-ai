{
  "id": "unidb-example-supplier-scenario",
  "name": "Supplier Scenario Example",
  "description": "Proposed Uni-DB agent initialization for the supplier-scenario design example.",
  "agents": [
    {
      "id": "unidb-supplier-scenario",
      "name": "Uni-DB",
      "description": "Owns the example database and executes configured operations.",
      "class_name": "rustic_ai.unidb.agent.UniDBAgent",
      "properties": {
        "binding_id": "supplier-scenario",
        "admission": "require_database_ready",
        "limits": {
          "timeout_ms": 5000,
          "max_query_memory_bytes": 67108864,
          "max_rows": 100,
          "max_output_bytes": 65536,
          "max_input_bytes": 65536,
          "max_statements": 16,
          "max_conflict_retries": 0
        },
        "raw_operations_enabled": false,
        "operation_catalog": {
          "revision": "supplier-scenario-v1",
          "operations": [
            {
              "name": "seed_supplier_scenario",
              "kind": "mutation",
              "parameters_schema": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "primary_supplier_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "primary_supplier_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "candidate_supplier_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "candidate_supplier_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "product_id",
                  "primary_supplier_id",
                  "primary_supplier_name",
                  "candidate_supplier_id",
                  "candidate_supplier_name"
                ],
                "additionalProperties": false
              },
              "statements": [
                {
                  "kind": "cypher",
                  "text": "CREATE (:Product {ext_id: $product_id, name: 'Digitizer'})"
                },
                {
                  "kind": "cypher",
                  "text": "CREATE (:Party {ext_id: $primary_supplier_id, name: $primary_supplier_name}), (:Party {ext_id: $candidate_supplier_id, name: $candidate_supplier_name})"
                },
                {
                  "kind": "cypher",
                  "text": "MATCH (s:Party {ext_id: $primary_supplier_id}), (p:Product {ext_id: $product_id}) CREATE (s)-[:SUPPLIES {reliability: 0.87, unit_cost_cents: 1800, lead_time_days: 7, min_order_qty: 100}]->(p)"
                }
              ],
              "checks": []
            },
            {
              "name": "part_availability",
              "kind": "evaluate",
              "parameters_schema": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "product_id"
                ],
                "additionalProperties": false
              },
              "program": "QUERY part_availability WHERE part.ext_id = $product_id RETURN part.ext_id AS product_id, availability AS availability",
              "columns": [
                "product_id",
                "availability"
              ]
            },
            {
              "name": "simulate_second_source",
              "kind": "scenario",
              "parameters_schema": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "supplier_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "reliability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "unit_cost_cents": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lead_time_days": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "min_order_qty": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "product_id",
                  "supplier_id",
                  "reliability",
                  "unit_cost_cents",
                  "lead_time_days",
                  "min_order_qty"
                ],
                "additionalProperties": false
              },
              "isolation": "scratch",
              "before": [
                {
                  "kind": "locy",
                  "text": "QUERY part_availability WHERE part.ext_id = $product_id RETURN part.ext_id AS product_id, availability AS availability"
                }
              ],
              "mutations": [
                {
                  "kind": "cypher",
                  "text": "MATCH (s:Party {ext_id: $supplier_id}), (p:Product {ext_id: $product_id}) CREATE (s)-[:SUPPLIES {reliability: $reliability, unit_cost_cents: $unit_cost_cents, lead_time_days: $lead_time_days, min_order_qty: $min_order_qty}]->(p)"
                }
              ],
              "after": [
                {
                  "kind": "locy",
                  "text": "QUERY part_availability WHERE part.ext_id = $product_id RETURN part.ext_id AS product_id, availability AS availability"
                }
              ],
              "warnings": [
                {
                  "source": "application_catalog",
                  "code": "independent_supplier_assumption",
                  "message": "Availability uses the configured independent-supplier assumption; it is not a calibrated guarantee."
                }
              ]
            },
            {
              "name": "qualify_second_source",
              "kind": "mutation",
              "parameters_schema": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "supplier_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "reliability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "unit_cost_cents": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lead_time_days": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "min_order_qty": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "product_id",
                  "supplier_id",
                  "reliability",
                  "unit_cost_cents",
                  "lead_time_days",
                  "min_order_qty"
                ],
                "additionalProperties": false
              },
              "statements": [
                {
                  "kind": "cypher",
                  "text": "MATCH (s:Party {ext_id: $supplier_id}), (p:Product {ext_id: $product_id}) CREATE (s)-[:SUPPLIES {reliability: $reliability, unit_cost_cents: $unit_cost_cents, lead_time_days: $lead_time_days, min_order_qty: $min_order_qty}]->(p)"
                }
              ],
              "checks": [
                {
                  "phase": "pre",
                  "statement": {
                    "kind": "cypher",
                    "text": "MATCH (s:Party {ext_id: $supplier_id}), (p:Product {ext_id: $product_id}) RETURN s.ext_id AS supplier_id, p.ext_id AS product_id"
                  },
                  "expect": {
                    "row_count": 1
                  }
                },
                {
                  "phase": "pre",
                  "statement": {
                    "kind": "cypher",
                    "text": "MATCH (s:Party {ext_id: $supplier_id}), (p:Product {ext_id: $product_id}) OPTIONAL MATCH (s)-[r:SUPPLIES]->(p) RETURN count(r) AS existing"
                  },
                  "expect": {
                    "row_count": 1,
                    "column": "existing",
                    "operator": "eq",
                    "value": 0
                  }
                },
                {
                  "phase": "post",
                  "statement": {
                    "kind": "locy",
                    "text": "QUERY part_availability WHERE part.ext_id = $product_id RETURN part.ext_id AS product_id, availability AS availability"
                  },
                  "expect": {
                    "row_count": 1,
                    "column": "availability",
                    "operator": "approx",
                    "value": 0.987,
                    "abs_tolerance": 1e-06
                  }
                }
              ],
              "statement_expectations": [
                {
                  "statement_index": 0,
                  "nodes_created": 0,
                  "relationships_created": 1
                }
              ]
            }
          ]
        }
      },
      "additional_topics": [
        "db.requests"
      ],
      "listen_to_default_topic": false,
      "dependency_map": {
        "unidb": {
          "class_name": "rustic_ai.unidb.resolver.UniDBResolver",
          "properties": {
            "binding_id": "supplier-scenario",
            "open_mode": "create",
            "location": {
              "kind": "filesystem",
              "dependency_key": "filesystem",
              "relative_path": "supplier-scenario-store"
            },
            "native_config": {
              "wal_enabled": true,
              "strict_schema": true
            },
            "bootstrap": {
              "policy": "apply_to_new",
              "revision": "supplier-scenario-v1",
              "schema": {
                "labels": [
                  {
                    "name": "Product",
                    "properties": [
                      {
                        "name": "name",
                        "type": "string",
                        "nullable": false
                      }
                    ]
                  },
                  {
                    "name": "Party",
                    "properties": [
                      {
                        "name": "name",
                        "type": "string",
                        "nullable": false
                      }
                    ]
                  }
                ],
                "edge_types": [
                  {
                    "name": "SUPPLIES",
                    "source_labels": [
                      "Party"
                    ],
                    "target_labels": [
                      "Product"
                    ],
                    "properties": [
                      {
                        "name": "reliability",
                        "type": "float64",
                        "nullable": false
                      },
                      {
                        "name": "unit_cost_cents",
                        "type": "int64",
                        "nullable": false
                      },
                      {
                        "name": "lead_time_days",
                        "type": "int64",
                        "nullable": false
                      },
                      {
                        "name": "min_order_qty",
                        "type": "int64",
                        "nullable": false
                      }
                    ]
                  }
                ]
              },
              "rule_programs": [
                {
                  "id": "supplier-scenario-rules-v1",
                  "text": "CREATE RULE part_availability AS\n  MATCH (part:Product)<-[supply:SUPPLIES]-(supplier:Party)\n  FOLD availability = MNOR(supply.reliability)\n  YIELD KEY part, availability PROB\n"
                }
              ]
            },
            "receipts": {
              "mode": "same_transaction",
              "namespace": "__rustic_unidb"
            }
          }
        }
      }
    }
  ],
  "dependency_map": {
    "filesystem": {
      "class_name": "rustic_ai.core.guild.agent_ext.depends.filesystem.filesystem.FileSystemResolver",
      "properties": {
        "path_base": "/tmp/rustic-unidb-design-examples",
        "protocol": "file",
        "storage_options": {}
      }
    }
  },
  "routes": {
    "steps": [
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBCapabilitiesResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBHealthResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBQueryResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBMutateResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBEvaluateResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBExplainResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBScenarioResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      },
      {
        "agent": {
          "id": "unidb-supplier-scenario",
          "name": "Uni-DB"
        },
        "message_format": "rustic_ai.unidb.models.DBOperationStatusResponse",
        "destination": {
          "topics": "db.results"
        },
        "route_times": -1
      }
    ]
  },
  "properties": {
    "example_guild_policy": {
      "owner": "embedding_guild_boundary",
      "enforcement": "application_provided_not_automatic",
      "caller_profiles": {
        "demo-ingester": [
          "query",
          "mutation",
          "capabilities",
          "health",
          "operation_status"
        ],
        "demo-reasoner": [
          "query",
          "evaluate",
          "explain",
          "scenario",
          "capabilities",
          "health"
        ],
        "demo-approved-executor": [
          "query",
          "evaluate",
          "mutation",
          "operation_status"
        ]
      },
      "operation_allowlists": {
        "demo-ingester": [
          "seed_supplier_scenario"
        ],
        "demo-reasoner": [
          "part_availability",
          "simulate_second_source"
        ],
        "demo-approved-executor": [
          "qualify_second_source",
          "part_availability"
        ]
      }
    }
  }
}
